# Fibonacci numbers using a plan with two results.
# run: 0 => 0
# run: 1 => 1
# run: 10 => 55
# run: 93 => 12200160415121876738
P1 fib (V0[:8.0]) → R0[:64.0]
  0 → Z0[:64.0]
  1 → Z1[:64.0]
  W1(V0) [
    step(Z0, Z1) → Z0, Z1
  ]
  Z0 → R0
END

P2 step (V0[:64.0], V1[:64.0]) → (R0[:64.0], R1[:64.0])
  V1 → R0
  V0 + V1 → R1
END
