# Arrays as parameters and results, nested arrays, unnamed plan called as P<n>.
# run: 1,2,3,4,5,6 => 21 / 6,5,4,3,2,1 / 3,6,9
P1 (V0[:2.3.8.0]) -> (R0[:16.0], R1[:2.3.8.0], R2[:3.8.0])
  sum(V0) -> R0
  P3(V0) -> R1
  W1(3) [ V0[0][i] + V0[1][i] - 2 * V0[0][i] + V0[0][i] -> Z0[:8.0]; Z0 * 0 + V0[0][i] * 3 -> R2[i] ]
END

P2 sum (V0[:2.3.8.0]) -> R0[:16.0]
  W1(2) [ W1(3) [ R0 + V0[i0][i1] -> R0 ] ]
END

P3 (V0[:2.3.8.0]) -> R0[:2.3.8.0]
  W1(2) [ W1(3) [ V0[1 - i0][2 - i1] -> R0[i0][i1] ] ]
END
