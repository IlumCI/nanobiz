# ============================================================================
#  A character-level autoregressive transformer language model in Plankalkül
# ============================================================================
#
#  Decoder-only, Llama-style architecture, trained from scratch with
#  hand-written backpropagation, then sampled autoregressively.
#
#    tokens ─ embedding E (tied with the output layer, Press & Wolf 2016)
#           ─ RMSNorm (Zhang & Sennrich 2019)
#           ─ causal self-attention, 2 heads, rotary positions (Su et al. 2021)
#           ─ residual
#           ─ RMSNorm ─ SwiGLU MLP (Shazeer 2020) ─ residual
#           ─ RMSNorm ─ logits = h · Eᵀ ─ softmax cross-entropy
#
#  Optimiser: AdamW (Loshchilov & Hutter 2019) for embeddings and norm gains;
#  for the hidden matrices either AdamW or Muon (Nesterov momentum,
#  Newton–Schulz orthogonalisation, update scale 0.2·√max(A,B), decoupled
#  weight decay; Jordan et al. 2024, Liu et al. 2025). Warm-up plus cosine
#  learning-rate schedule, global gradient-norm clipping at 1.
#
#  Sizes: vocabulary 28 (a–z, space, full stop), context 16, width 16,
#  2 heads of 8, MLP hidden width 32; 3056 parameters.
#
#  Data layout. Parameters live in one flat vector P (3056.f64):
#
#     offset  size        parameter
#        0    28 × 16     E    token embedding = output matrix
#      448    16          g1   gain of the attention RMSNorm
#      464    16 × 16     Wq
#      720    16 × 16     Wk
#      976    16 × 16     Wv
#     1232    16 × 16     Wo
#     1488    16          g2   gain of the MLP RMSNorm
#     1504    16 × 32     W1   SwiGLU gate
#     2016    16 × 32     W3   SwiGLU value
#     2528    32 × 16     W2   SwiGLU output
#     3040    16          gf   gain of the final RMSNorm
#
#  Activations are 512.f64 buffers holding a 16 × width matrix row-major
#  (width 16, 28 or 32), or a vector in its first entries. The forward pass
#  returns all of them in a cache C (18.512.f64):
#
#      0 X    embeddings        6 PR  attention probabilities   12 A3  x·W3
#      1 N1   RMSNorm 1         7 O   attention output          13 U   SwiGLU
#      2 RS1  1/rms 1           8 H   X + O·Wo                  14 Y   H + U·W2
#      3 Q    rotated queries   9 N2  RMSNorm 2                 15 NF  final norm
#      4 K    rotated keys     10 RS2 1/rms 2                   16 RSF 1/rms final
#      5 V    values           11 A1  x·W1                      17 LG  logits
#
#  Entry plans:
#     lm         train and generate          (see examples/lm/run.sh)
#     gradcheck  finite-difference check of the analytic gradient
# ============================================================================


# --------------------------------------------------------------------------
#  Entry: train on a 256-character corpus, then continue an 8-character
#  prompt by 64 sampled characters.
#    V0 corpus   V1 prompt   V2 seed   V3 steps
#    V4 sampling temperature (0 = greedy)   V5 1 = Muon, 0 = AdamW only
#  R0: mean training loss in each tenth of training; R1: generated text.
# --------------------------------------------------------------------------
P1 lm (V0[:256.8.0], V1[:8.8.0], V2[:64.0], V3[:32.0], V4[:f64], V5[:0]) → (R0[:10.f64], R1[:64.8.0])
  W1(256) [ ASSERT V0[i] < 28 ]
  W1(8) [ ASSERT V1[i] < 28 ]
  ropetab() → Z0[:128.f64]
  train(V0, V2, V3, Z0, V5) → Z1[:3056.f64], R0, Z2[:64.0]
  generate(Z1, V1, Z2, Z0, V4) → R1
END


# --------------------------------------------------------------------------
#  Entry: compare the backpropagated gradient with central differences for
#  every parameter, at random parameters and a random sequence.
#  R0: largest relative error; R1: loss at those parameters.
# --------------------------------------------------------------------------
P2 gradcheck (V0[:64.0]) → (R0[:f64], R1[:f64])
  ropetab() → Z0[:128.f64]
  init(V0) → Z1[:3056.f64], Z2[:64.0]
  W1(3056) [ rng(Z2) → Z2, Z3[:f64]; Z1[i] + 0.2 × (Z3 - 0.5) → Z1[i] ]
  W1(17) [ rng(Z2) → Z2, Z3; Z3 × 28.0 → Z4[:17.8.0][i] ]
  fwdbwd(Z1, Z4, Z0) → Z5[:3056.f64], R1
  W1(3056) [
    Z1[i] → Z6[:f64]
    Z6 + 0.00001 → Z1[i]
    loss(Z1, Z4, Z0) → Z7[:f64]
    Z6 - 0.00001 → Z1[i]
    loss(Z1, Z4, Z0) → Z8[:f64]
    Z6 → Z1[i]
    (Z7 - Z8) / 0.00002 → Z9[:f64]                    # numerical derivative
    Z5[i] - Z9 → Z10[:f64]
    (Z10 < 0.0) → -Z10 → Z10
    abs(Z5[i]) + abs(Z9) + 0.000001 → Z11[:f64]
    (Z10 / Z11 > R0) → Z10 / Z11 → R0
  ]
END


# ==========================================================================
#  Training
# ==========================================================================

# V0 corpus, V1 seed, V2 steps, V3 rotary table, V4 Muon on/off
# R0 trained parameters, R1 loss curve, R2 random state
P3 train (V0[:256.8.0], V1[:64.0], V2[:32.0], V3[:128.f64], V4[:0]) → (R0[:3056.f64], R1[:10.f64], R2[:64.0])
  init(V1) → R0, R2
  1.0 → Z0[:f64]                                      # β1^t
  1.0 → Z1[:f64]                                      # β2^t
  V2 / 20 → Z16[:32.0]                                # warm-up steps
  (Z16 = 0) → 1 → Z16
  W1(V2) [
    # --- gradient of the mean loss over a batch of 4 random windows ---
    W1(3056) [ 0.0 → Z2[:3056.f64][i] ]
    0.0 → Z3[:f64]
    W1(4) [
      rng(R2) → R2, Z4[:f64]
      Z4 × 240.0 → Z5[:16.0]                          # window start 0 .. 239
      W1(17) [ V0[Z5 + i] → Z6[:17.8.0][i] ]
      fwdbwd(R0, Z6, V3) → Z7[:3056.f64], Z8[:f64]
      W1(3056) [ Z2[i] + Z7[i] → Z2[i] ]
      Z3 + Z8 → Z3
    ]
    Z3 / 4.0 → Z3
    ASSERT Z3 = Z3                                    # the loss is not NaN

    # --- clip the global gradient norm at 1 ---
    0.0 → Z9[:f64]
    W1(3056) [ Z2[i] × 0.25 → Z2[i]; Z9 + Z2[i] × Z2[i] → Z9 ]
    sqrt(Z9) → Z9
    1.0 → Z10[:f64]
    (Z9 > 1.0) → 1.0 / Z9 → Z10
    W1(3056) [ Z2[i] × Z10 → Z2[i] ]

    # --- learning rate: linear warm-up, cosine decay from 0.01 to 0.001 ---
    (i0 < Z16) → 0.01 × (i0 + 1) / Z16 → Z13[:f64]
    (i0 ≥ Z16) → [
      (i0 - Z16) / (V2 - Z16 + 0.0) → Z17[:f64]       # progress in [0, 1)
      sincos(3.141592653589793 × Z17) → Z18[:f64], Z19[:f64]
      0.001 + 0.0045 × (1.0 + Z19) → Z13
    ]

    # --- AdamW: β1 = 0.9, β2 = 0.95, ε = 1e-8, weight decay 0.1 on matrices ---
    Z0 × 0.9 → Z0
    Z1 × 0.95 → Z1
    W1(3056) [
      (i ≥ 448) ∧ (i < 464) ∨ (i ≥ 1488) ∧ (i < 1504) ∨ (i ≥ 3040) → Z20[:0]    # norm gain
      (i ≥ 464) ∧ (i < 3040) ∧ ¬Z20 → Z21[:0]                                  # hidden matrix
      ¬(V4 ∧ Z21) → [
        0.9 × Z11[:3056.f64][i] + 0.1 × Z2[i] → Z11[i]
        0.95 × Z12[:3056.f64][i] + 0.05 × Z2[i] × Z2[i] → Z12[i]
        0.1 → Z14[:f64]
        Z20 → 0.0 → Z14
        Z11[i] / (1.0 - Z0) / (sqrt(Z12[i] / (1.0 - Z1)) + 0.00000001) → Z15[:f64]
        R0[i] - Z13 × (Z15 + Z14 × R0[i]) → R0[i]
      ]
    ]

    # --- Muon for the seven hidden matrices ---
    V4 → [
      muon(R0, Z2, Z22[:3056.f64], 464, 16, 16, Z13) → R0, Z22
      muon(R0, Z2, Z22, 720, 16, 16, Z13) → R0, Z22
      muon(R0, Z2, Z22, 976, 16, 16, Z13) → R0, Z22
      muon(R0, Z2, Z22, 1232, 16, 16, Z13) → R0, Z22
      muon(R0, Z2, Z22, 1504, 16, 32, Z13) → R0, Z22
      muon(R0, Z2, Z22, 2016, 16, 32, Z13) → R0, Z22
      muon(R0, Z2, Z22, 2528, 32, 16, Z13) → R0, Z22
    ]

    # --- loss curve ---
    i0 × 10 / V2 → Z23[:8.0]
    R1[Z23] + Z3 → R1[Z23]
    Z24[:10.f64][Z23] + 1.0 → Z24[Z23]
  ]
  W1(10) [ (Z24[i] > 0.0) → R1[i] / Z24[i] → R1[i] ]
END

# One Muon step for the r × c matrix at offset V3 (Liu et al. 2025, eq. 4):
#   M ← μM + G;  O = NewtonSchulz(μM + G);  W ← W − lr·(0.2·√max(r,c)·O + λW)
# with μ = 0.95 and λ = 0.1. A tall matrix is orthogonalised transposed.
P4 muon (V0[:3056.f64], V1[:3056.f64], V2[:3056.f64], V3[:16.0], V4[:8.0], V5[:8.0], V6[:f64]) → (R0[:3056.f64], R1[:3056.f64])
  V0 → R0
  V2 → R1
  W1(V4) [ W1(V5) [
    V3 + i0 × V5 + i1 → Z0[:16.0]
    0.95 × R1[Z0] + V1[Z0] → R1[Z0]
    0.95 × R1[Z0] + V1[Z0] → Z1[:f64]                 # Nesterov
    (V4 ≤ V5) → Z1 → Z2[:512.f64][i0 × V5 + i1]
    (V4 > V5) → Z1 → Z2[i1 × V4 + i0]
  ] ]
  (V4 ≤ V5) → orth(Z2, V4, V5) → Z3[:512.f64]
  (V4 > V5) → orth(Z2, V5, V4) → Z3
  V5 → Z4[:f64]
  (V4 > V5) → V4 → Z4
  0.2 × sqrt(Z4) → Z4
  W1(V4) [ W1(V5) [
    V3 + i0 × V5 + i1 → Z0
    (V4 ≤ V5) → Z3[i0 × V5 + i1] → Z1
    (V4 > V5) → Z3[i1 × V4 + i0] → Z1
    R0[Z0] - V6 × (Z4 × Z1 + 0.1 × R0[Z0]) → R0[Z0]
  ] ]
END

# Newton–Schulz orthogonalisation of an r × c matrix, r ≤ c ≤ 32:
#   X ← G/‖G‖_F;  5 × { A = XXᵀ;  X ← aX + (bA + cA²)X }
# with (a, b, c) = (3.4445, −4.7750, 2.0315).
P5 orth (V0[:512.f64], V1[:8.0], V2[:8.0]) → R0[:512.f64]
  0.0 → Z0[:f64]
  W1(V1) [ W1(V2) [ Z0 + V0[i0 × V2 + i1] × V0[i0 × V2 + i1] → Z0 ] ]
  1.0 / (sqrt(Z0) + 0.0000001) → Z0
  W1(V1) [ W1(V2) [ V0[i0 × V2 + i1] × Z0 → R0[i0 × V2 + i1] ] ]
  W1(5) [
    W1(V1) [ W1(V1) [                                 # A = X Xᵀ
      0.0 → Z1[:f64]
      W1(V2) [ Z1 + R0[i1 × V2 + i3] × R0[i2 × V2 + i3] → Z1 ]
      Z1 → Z2[:256.f64][i1 × V1 + i2]
    ] ]
    W1(V1) [ W1(V1) [                                 # B = bA + cA²
      0.0 → Z1
      W1(V1) [ Z1 + Z2[i1 × V1 + i3] × Z2[i3 × V1 + i2] → Z1 ]
      -4.7750 × Z2[i1 × V1 + i2] + 2.0315 × Z1 → Z3[:256.f64][i1 × V1 + i2]
    ] ]
    W1(V1) [ W1(V2) [                                 # X ← aX + BX
      0.0 → Z1
      W1(V1) [ Z1 + Z3[i1 × V1 + i3] × R0[i3 × V2 + i2] → Z1 ]
      3.4445 × R0[i1 × V2 + i2] + Z1 → Z4[:512.f64][i1 × V2 + i2]
    ] ]
    Z4 → R0
  ]
END

# Parameter initialisation: uniform with standard deviation 1/√fan-in,
# norm gains 1. R1 is the random state after initialisation.
P6 init (V0[:64.0]) → (R0[:3056.f64], R1[:64.0])
  V0 ⊕ 0x9E3779B97F4A7C15 → R1
  (R1 = 0) → 1 → R1
  W1(3056) [
    rng(R1) → R1, Z0[:f64]
    (Z0 × 2.0 - 1.0) × 1.7320508075688772 → Z1[:f64]    # unit variance
    0.25 → Z2[:f64]                                      # fan-in 16
    (i ≥ 2528) ∧ (i < 3040) → 0.1767766952966369 → Z2   # W2: fan-in 32
    Z1 × Z2 → R0[i]
    (i ≥ 448) ∧ (i < 464) ∨ (i ≥ 1488) ∧ (i < 1504) ∨ (i ≥ 3040) → 1.0 → R0[i]
  ]
END


# ==========================================================================
#  Generation
# ==========================================================================

# Continue the prompt V1 by 64 tokens. Each step runs the model on the last
# (at most) 16 tokens and samples from softmax(logits / V4); V4 = 0 is greedy.
P7 generate (V0[:3056.f64], V1[:8.8.0], V2[:64.0], V3[:128.f64], V4[:f64]) → R0[:64.8.0]
  W1(8) [ V1[i] → Z0[:72.8.0][i] ]
  8 → Z1[:64.0]                                       # tokens so far
  V2 → Z2[:64.0]                                      # random state
  W1(64) [
    0 → Z3[:64.0]                                     # window start
    (Z1 > 16) → Z1 - 16 → Z3
    W1(16) [
      0 → Z4[:16.8.0][i]
      (Z3 + i < Z1) → Z0[Z3 + i] → Z4[i]
    ]
    Z1 - Z3 - 1 → Z5[:64.0]                           # position of the last token
    forward(V0, Z4, V3) → Z6[:18.512.f64]
    -1.0e300 → Z7[:f64]                               # greedy choice and max logit
    0 → Z8[:8.0]
    W1(28) [ (Z6[17][Z5 × 28 + i] > Z7) → [ Z6[17][Z5 × 28 + i] → Z7; i → Z8 ] ]
    (V4 > 0.0) → [
      0.0 → Z9[:f64]
      W1(28) [
        exp((Z6[17][Z5 × 28 + i] - Z7) / V4) → Z10[:28.f64][i]
        Z9 + Z10[i] → Z9
      ]
      rng(Z2) → Z2, Z11[:f64]
      Z11 × Z9 → Z11                                  # inverse CDF
      W1(28) [ (Z11 ≥ 0.0) → [ i → Z8; Z11 - Z10[i] → Z11 ] ]
    ]
    Z8 → Z0[Z1]
    Z1 + 1 → Z1
  ]
  W1(64) [ Z0[8 + i] → R0[i] ]
END


# ==========================================================================
#  Forward pass
# ==========================================================================

P8 forward (V0[:3056.f64], V1[:16.8.0], V2[:128.f64]) → R0[:18.512.f64]
  W1(16) [                                            # X = E[token]
    V1[i0] → Z0[:64.0]
    W1(16) [ V0[Z0 × 16 + i1] → R0[0][i0 × 16 + i1] ]
  ]
  rmsnorm(V0, R0[0], 448) → R0[1], R0[2]
  lin(V0, R0[1], 464, 16, 16) → Z1[:512.f64]
  rope(Z1, V2, 0) → R0[3]
  lin(V0, R0[1], 720, 16, 16) → Z1
  rope(Z1, V2, 0) → R0[4]
  lin(V0, R0[1], 976, 16, 16) → R0[5]
  attention(R0[3], R0[4], R0[5]) → R0[7], R0[6]
  lin(V0, R0[7], 1232, 16, 16) → Z1
  W1(256) [ R0[0][i] + Z1[i] → R0[8][i] ]            # residual
  rmsnorm(V0, R0[8], 1488) → R0[9], R0[10]
  lin(V0, R0[9], 1504, 16, 32) → R0[11]
  lin(V0, R0[9], 2016, 16, 32) → R0[12]
  swiglu(R0[11], R0[12]) → R0[13]
  lin(V0, R0[13], 2528, 32, 16) → Z1
  W1(256) [ R0[8][i] + Z1[i] → R0[14][i] ]           # residual
  rmsnorm(V0, R0[14], 3040) → R0[15], R0[16]
  unembed(V0, R0[15]) → R0[17]
END

# Mean next-token cross-entropy of a 17-token sequence.
P9 loss (V0[:3056.f64], V1[:17.8.0], V2[:128.f64]) → R0[:f64]
  W1(16) [ V1[i] → Z0[:16.8.0][i] ]
  forward(V0, Z0, V2) → Z1[:18.512.f64]
  xent(Z1[17], V1) → R0, Z2[:512.f64]
END


# ==========================================================================
#  Backward pass: gradient R0 of the mean cross-entropy of V1 with respect
#  to every parameter, and the loss R1.
# ==========================================================================

P10 fwdbwd (V0[:3056.f64], V1[:17.8.0], V2[:128.f64]) → (R0[:3056.f64], R1[:f64])
  W1(16) [ V1[i] → Z0[:16.8.0][i] ]
  forward(V0, Z0, V2) → Z1[:18.512.f64]
  xent(Z1[17], V1) → R1, Z2[:512.f64]                 # Z2 = dLG

  # output layer (tied embedding) and final norm
  unembedback(V0, Z1[15], Z2) → Z3[:512.f64], Z4[:512.f64]
  W1(448) [ R0[i] + Z4[i] → R0[i] ]
  rmsback(V0, Z1[14], Z1[16], Z3, 3040) → Z5[:512.f64], Z4
  W1(16) [ R0[3040 + i] + Z4[i] → R0[3040 + i] ]     # Z5 = dY

  # MLP block: Y = H + SwiGLU(N2)·W2
  linback(V0, Z1[13], Z5, 2528, 32, 16) → Z6[:512.f64], Z4
  W1(512) [ R0[2528 + i] + Z4[i] → R0[2528 + i] ]
  swigluback(Z1[11], Z1[12], Z6) → Z7[:512.f64], Z8[:512.f64]
  linback(V0, Z1[9], Z7, 1504, 16, 32) → Z3, Z4
  W1(512) [ R0[1504 + i] + Z4[i] → R0[1504 + i] ]
  linback(V0, Z1[9], Z8, 2016, 16, 32) → Z6, Z4
  W1(512) [ R0[2016 + i] + Z4[i] → R0[2016 + i] ]
  W1(256) [ Z3[i] + Z6[i] → Z3[i] ]                  # dN2
  rmsback(V0, Z1[8], Z1[10], Z3, 1488) → Z6, Z4
  W1(16) [ R0[1488 + i] + Z4[i] → R0[1488 + i] ]
  W1(256) [ Z5[i] + Z6[i] → Z5[i] ]                  # Z5 = dH

  # attention block: H = X + O·Wo
  linback(V0, Z1[7], Z5, 1232, 16, 16) → Z3, Z4      # Z3 = dO
  W1(256) [ R0[1232 + i] + Z4[i] → R0[1232 + i] ]
  attnback(Z1[3], Z1[4], Z1[5], Z1[6], Z3) → Z6, Z7[:512.f64], Z8
  rope(Z6, V2, 1) → Z6                                # undo the rotations
  rope(Z7, V2, 1) → Z7
  linback(V0, Z1[1], Z6, 464, 16, 16) → Z3, Z4
  W1(256) [ R0[464 + i] + Z4[i] → R0[464 + i] ]
  linback(V0, Z1[1], Z7, 720, 16, 16) → Z6, Z4
  W1(256) [ R0[720 + i] + Z4[i] → R0[720 + i] ]
  W1(256) [ Z3[i] + Z6[i] → Z3[i] ]
  linback(V0, Z1[1], Z8, 976, 16, 16) → Z6, Z4
  W1(256) [ R0[976 + i] + Z4[i] → R0[976 + i] ]
  W1(256) [ Z3[i] + Z6[i] → Z3[i] ]                  # dN1
  rmsback(V0, Z1[0], Z1[2], Z3, 448) → Z6, Z4
  W1(16) [ R0[448 + i] + Z4[i] → R0[448 + i] ]
  W1(256) [ Z5[i] + Z6[i] → Z5[i] ]                  # Z5 = dX

  # input embedding (same matrix as the output layer)
  W1(16) [
    V1[i0] → Z9[:64.0]
    W1(16) [ R0[Z9 × 16 + i1] + Z5[i0 × 16 + i1] → R0[Z9 × 16 + i1] ]
  ]
END


# ==========================================================================
#  Layers. X, Y are 16 × n matrices in 512.f64 buffers; weights are read
#  from the parameter vector V0 at an offset.
# ==========================================================================

# Y = X·W, W = P[off ..] as nin × nout
P11 lin (V0[:3056.f64], V1[:512.f64], V2[:16.0], V3[:8.0], V4[:8.0]) → R0[:512.f64]
  W1(16) [ W1(V4) [ W1(V3) [
    R0[i0 × V4 + i1] + V1[i0 × V3 + i2] × V0[V2 + i2 × V4 + i1] → R0[i0 × V4 + i1]
  ] ] ]
END

# dX = dY·Wᵀ (R0) and dW = Xᵀ·dY (R1)
P12 linback (V0[:3056.f64], V1[:512.f64], V2[:512.f64], V3[:16.0], V4[:8.0], V5[:8.0]) → (R0[:512.f64], R1[:512.f64])
  W1(16) [ W1(V4) [ W1(V5) [
    R0[i0 × V4 + i1] + V2[i0 × V5 + i2] × V0[V3 + i1 × V5 + i2] → R0[i0 × V4 + i1]
    R1[i1 × V5 + i2] + V1[i0 × V4 + i1] × V2[i0 × V5 + i2] → R1[i1 × V5 + i2]
  ] ] ]
END

# logits = NF·Eᵀ  (16 × 28)
P13 unembed (V0[:3056.f64], V1[:512.f64]) → R0[:512.f64]
  W1(16) [ W1(28) [ W1(16) [
    R0[i0 × 28 + i1] + V1[i0 × 16 + i2] × V0[i1 × 16 + i2] → R0[i0 × 28 + i1]
  ] ] ]
END

# dNF = dLG·E (R0), dE = dLGᵀ·NF (R1)
P14 unembedback (V0[:3056.f64], V1[:512.f64], V2[:512.f64]) → (R0[:512.f64], R1[:512.f64])
  W1(16) [ W1(28) [ W1(16) [
    R0[i0 × 16 + i2] + V2[i0 × 28 + i1] × V0[i1 × 16 + i2] → R0[i0 × 16 + i2]
    R1[i1 × 16 + i2] + V2[i0 × 28 + i1] × V1[i0 × 16 + i2] → R1[i1 × 16 + i2]
  ] ] ]
END

# RMSNorm: N = X · rs · g, rs = 1/√(mean(X²) + 1e-5); R1[t] = rs of row t
P15 rmsnorm (V0[:3056.f64], V1[:512.f64], V2[:16.0]) → (R0[:512.f64], R1[:512.f64])
  W1(16) [
    0.0 → Z0[:f64]
    W1(16) [ Z0 + V1[i0 × 16 + i1] × V1[i0 × 16 + i1] → Z0 ]
    1.0 / sqrt(Z0 / 16.0 + 0.00001) → R1[i0]
    W1(16) [ V1[i0 × 16 + i1] × R1[i0] × V0[V2 + i1] → R0[i0 × 16 + i1] ]
  ]
END

# RMSNorm backward, with x̂ = X·rs and dx̂ = dN·g:
#   dX = rs·(dx̂ − x̂·mean(dx̂·x̂)),  dg = Σ_t dN·x̂
P16 rmsback (V0[:3056.f64], V1[:512.f64], V2[:512.f64], V3[:512.f64], V4[:16.0]) → (R0[:512.f64], R1[:512.f64])
  W1(16) [
    0.0 → Z0[:f64]
    W1(16) [
      V1[i0 × 16 + i1] × V2[i0] → Z1[:f64]
      Z0 + V3[i0 × 16 + i1] × V0[V4 + i1] × Z1 → Z0
      R1[i1] + V3[i0 × 16 + i1] × Z1 → R1[i1]
    ]
    Z0 / 16.0 → Z0
    W1(16) [
      V2[i0] × (V3[i0 × 16 + i1] × V0[V4 + i1] - V1[i0 × 16 + i1] × V2[i0] × Z0) → R0[i0 × 16 + i1]
    ]
  ]
END

# Rotary position embedding of 16 × 16 queries or keys: in each head of 8,
# the pairs (2k, 2k+1) are rotated by t·θ_k. V2 = 1 applies the inverse
# (transposed) rotation, which is the backward pass.
P17 rope (V0[:512.f64], V1[:128.f64], V2[:0]) → R0[:512.f64]
  V0 → R0
  W1(16) [ W1(2) [ W1(4) [
    i0 × 16 + i1 × 8 + 2 × i2 → Z0[:16.0]
    V1[i0 × 4 + i2] → Z1[:f64]                        # cos
    V1[64 + i0 × 4 + i2] → Z2[:f64]                   # sin
    V2 → -Z2 → Z2
    V0[Z0] × Z1 - V0[Z0 + 1] × Z2 → R0[Z0]
    V0[Z0] × Z2 + V0[Z0 + 1] × Z1 → R0[Z0 + 1]
  ] ] ]
END

# cos(t·θ_k) at [4t + k] and sin at [64 + 4t + k], θ_k = 10000^(−k/4)
P18 ropetab () → R0[:128.f64]
  W1(4) [
    exp(-2.302585092994046 × i0) → Z0[:f64]
    W1(16) [
      sincos(Z0 × i1) → Z1[:f64], Z2[:f64]
      Z2 → R0[i1 × 4 + i0]
      Z1 → R0[64 + i1 × 4 + i0]
    ]
  ]
END

# Causal self-attention, 2 heads of 8: R0 = O, R1[256h + 16t + u] = P_h[t][u]
P19 attention (V0[:512.f64], V1[:512.f64], V2[:512.f64]) → (R0[:512.f64], R1[:512.f64])
  W1(2) [ W1(16) [                                    # head i0, query t = i1
    -1.0e300 → Z0[:f64]
    W1(i1 + 1) [                                      # key u = i2 ≤ t
      0.0 → Z1[:f64]
      W1(8) [ Z1 + V0[i1 × 16 + i0 × 8 + i3] × V1[i2 × 16 + i0 × 8 + i3] → Z1 ]
      Z1 × 0.35355339059327373 → Z1                   # 1/√8
      Z1 → R1[i0 × 256 + i1 × 16 + i2]
      (Z1 > Z0) → Z1 → Z0
    ]
    0.0 → Z2[:f64]
    W1(i1 + 1) [
      exp(R1[i0 × 256 + i1 × 16 + i2] - Z0) → R1[i0 × 256 + i1 × 16 + i2]
      Z2 + R1[i0 × 256 + i1 × 16 + i2] → Z2
    ]
    W1(i1 + 1) [ R1[i0 × 256 + i1 × 16 + i2] / Z2 → R1[i0 × 256 + i1 × 16 + i2] ]
    W1(8) [
      0.0 → Z3[:f64]
      W1(i1 + 1) [ Z3 + R1[i0 × 256 + i1 × 16 + i3] × V2[i3 × 16 + i0 × 8 + i2] → Z3 ]
      Z3 → R0[i1 × 16 + i0 × 8 + i2]
    ]
  ] ]
END

# Attention backward: from dO (V4) to dQ, dK, dV
#   dP = dO·Vᵀ,  dS = P ⊙ (dP − rowsum(P ⊙ dP)) / √8,
#   dQ = dS·K,  dK = dSᵀ·Q,  dV = Pᵀ·dO
P20 attnback (V0[:512.f64], V1[:512.f64], V2[:512.f64], V3[:512.f64], V4[:512.f64]) → (R0[:512.f64], R1[:512.f64], R2[:512.f64])
  W1(2) [ W1(16) [                                    # head i0, query t = i1
    0.0 → Z1[:f64]
    W1(i1 + 1) [                                      # key u = i2
      0.0 → Z2[:f64]
      W1(8) [ Z2 + V4[i1 × 16 + i0 × 8 + i3] × V2[i2 × 16 + i0 × 8 + i3] → Z2 ]
      Z2 → Z0[:16.f64][i2]
      Z1 + V3[i0 × 256 + i1 × 16 + i2] × Z2 → Z1
      W1(8) [
        R2[i2 × 16 + i0 × 8 + i3] + V3[i0 × 256 + i1 × 16 + i2] × V4[i1 × 16 + i0 × 8 + i3] → R2[i2 × 16 + i0 × 8 + i3]
      ]
    ]
    W1(i1 + 1) [
      V3[i0 × 256 + i1 × 16 + i2] × (Z0[i2] - Z1) × 0.35355339059327373 → Z3[:f64]
      W1(8) [
        R0[i1 × 16 + i0 × 8 + i3] + Z3 × V1[i2 × 16 + i0 × 8 + i3] → R0[i1 × 16 + i0 × 8 + i3]
        R1[i2 × 16 + i0 × 8 + i3] + Z3 × V0[i1 × 16 + i0 × 8 + i3] → R1[i2 × 16 + i0 × 8 + i3]
      ]
    ]
  ] ]
END

# SwiGLU: U = silu(A1) ⊙ A3,  silu(z) = z·σ(z)
P21 swiglu (V0[:512.f64], V1[:512.f64]) → R0[:512.f64]
  W1(512) [ V0[i] × sigmoid(V0[i]) × V1[i] → R0[i] ]
END

# dA1 = dU ⊙ A3 ⊙ σ(A1)(1 + A1(1 − σ(A1))),  dA3 = dU ⊙ silu(A1)
P22 swigluback (V0[:512.f64], V1[:512.f64], V2[:512.f64]) → (R0[:512.f64], R1[:512.f64])
  W1(512) [
    sigmoid(V0[i]) → Z0[:f64]
    V2[i] × V1[i] × Z0 × (1.0 + V0[i] × (1.0 - Z0)) → R0[i]
    V2[i] × V0[i] × Z0 → R1[i]
  ]
END

# Mean cross-entropy of the logits (V0, 16 × 28) against the next tokens of
# V1, and its gradient R1 = (softmax − onehot) / 16
P23 xent (V0[:512.f64], V1[:17.8.0]) → (R0[:f64], R1[:512.f64])
  W1(16) [
    -1.0e300 → Z0[:f64]
    W1(28) [ (V0[i0 × 28 + i1] > Z0) → V0[i0 × 28 + i1] → Z0 ]
    0.0 → Z1[:f64]
    W1(28) [
      exp(V0[i0 × 28 + i1] - Z0) → R1[i0 × 28 + i1]
      Z1 + R1[i0 × 28 + i1] → Z1
    ]
    V1[i0 + 1] → Z2[:64.0]                            # target token
    R0 + ln(Z1) + Z0 - V0[i0 × 28 + Z2] → R0
    W1(28) [ R1[i0 × 28 + i1] / Z1 / 16.0 → R1[i0 × 28 + i1] ]
    R1[i0 × 28 + Z2] - 0.0625 → R1[i0 × 28 + Z2]
  ]
  R0 / 16.0 → R0
END


# ==========================================================================
#  Arithmetic library: the only primitives are +, −, ×, ÷ and comparisons.
# ==========================================================================

# e^x = 2^n · e^r with n = round(x / ln 2), |r| ≤ ln 2 / 2 (Cody–Waite
# reduction), e^r by its Taylor polynomial of degree 13, 2^n by squaring.
P30 exp (V0[:f64]) → R0[:f64]
  V0 → Z0[:f64]
  (Z0 > 700.0) → 700.0 → Z0
  (Z0 < -700.0) → -700.0 → Z0
  Z0 × 1.4426950408889634 → Z1[:f64]
  (Z1 ≥ 0.0) → Z1 + 0.5 → Z2[:±16.0]
  (Z1 < 0.0) → Z1 - 0.5 → Z2
  Z0 - Z2 × 0.6931471803691238 - Z2 × 0.00000000019082149292705877 → Z3[:f64]
  1.0 → R0
  W2(13) [ 1.0 + Z3 × R0 / (i + 1) → R0 ]
  Z2 → Z4[:±16.0]
  (Z4 < 0) → -Z4 → Z4
  2.0 → Z5[:f64]
  1.0 → Z6[:f64]
  W (Z4 > 0) [
    (Z4 % 2 = 1) → Z6 × Z5 → Z6
    Z5 × Z5 → Z5
    Z4 / 2 → Z4
  ]
  (Z2 ≥ 0) → R0 × Z6 → R0
  (Z2 < 0) → R0 / Z6 → R0
END

# ln x = e · ln 2 + 2 atanh((m − 1)/(m + 1)), x = m · 2^e, m ∈ [√½, √2)
P31 ln (V0[:f64]) → R0[:f64]
  ASSERT V0 > 0.0
  V0 → Z0[:f64]
  0 → Z1[:±16.0]
  W (Z0 > 1.4142135623730951) [ Z0 / 2.0 → Z0; Z1 + 1 → Z1 ]
  W (Z0 < 0.7071067811865476) [ Z0 × 2.0 → Z0; Z1 - 1 → Z1 ]
  (Z0 - 1.0) / (Z0 + 1.0) → Z2[:f64]
  Z2 × Z2 → Z3[:f64]
  1.0 / 41.0 → Z4[:f64]
  W2(20) [ 1.0 / (2 × i + 1) + Z3 × Z4 → Z4 ]
  2.0 × Z2 × Z4 + Z1 × 0.6931471805599453 → R0
END

# √x: scale x by powers of 4 into [1, 4), then 7 Newton steps from 1.5
P32 sqrt (V0[:f64]) → R0[:f64]
  ASSERT V0 ≥ 0.0
  (V0 > 0.0) → [
    V0 → Z0[:f64]
    1.0 → Z1[:f64]
    W (Z0 ≥ 4.0) [ Z0 / 4.0 → Z0; Z1 × 2.0 → Z1 ]
    W (Z0 < 1.0) [ Z0 × 4.0 → Z0; Z1 / 2.0 → Z1 ]
    1.5 → Z2[:f64]
    W1(7) [ (Z2 + Z0 / Z2) / 2.0 → Z2 ]
    Z2 × Z1 → R0
  ]
END

# sin and cos: reduce to [−π, π], then Taylor polynomials of degree 31/30
P33 sincos (V0[:f64]) → (R0[:f64], R1[:f64])
  V0 × 0.15915494309189535 → Z0[:f64]
  (Z0 ≥ 0.0) → Z0 + 0.5 → Z1[:±64.0]
  (Z0 < 0.0) → Z0 - 0.5 → Z1
  V0 - Z1 × 6.283185307179586 → Z2[:f64]
  Z2 × Z2 → Z3[:f64]
  1.0 → R0
  1.0 → R1
  W2(15) [
    1.0 - Z3 × R0 / ((2 × i + 2) × (2 × i + 3)) → R0
    1.0 - Z3 × R1 / ((2 × i + 1) × (2 × i + 2)) → R1
  ]
  R0 × Z2 → R0
END

P34 abs (V0[:f64]) → R0[:f64]
  V0 → R0
  (V0 < 0.0) → -V0 → R0
END

# The logistic function, written in Zuse's two-dimensional notation.
P35 sigmoid | (V)     ⇒ R
          V |  0        0
          S |  f64      f64

            | 1.0 / (1.0 + exp(-V))   ⇒ R
          V |                   0       0
END

# xorshift64* (Marsaglia 2003; Vigna 2016). Shifts are multiplications and
# divisions by powers of two. R1 is uniform in [0, 1) with 53 random bits.
P36 rng (V0[:64.0]) → (R0[:64.0], R1[:f64])
  V0 ⊕ V0 / 4096 → Z0[:64.0]
  Z0 ⊕ Z0 × 33554432 → Z0
  Z0 ⊕ Z0 / 134217728 → Z0
  Z0 → R0
  Z0 × 2685821657736338717 / 2048 → Z1[:64.0]
  Z1 × 0.00000000000000011102230246251565 → R1
END
